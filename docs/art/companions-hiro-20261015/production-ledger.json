      "state": "saved",
      "requestId": "GkesxQgGszsBsu1OXxdX",
      "chargedCharacters": "13"
    },
    {
      "id": "q6_faelen_price",
      "text": "Wardens cut for nothing. I am not a Warden. What is your debt worth?",
      "characters": 68,
      "state": "saved",
      "requestId": "GHhVLd7H7I494b49GQSp",
      "chargedCharacters": "30"
    },
    {
      "id": "q6_faelen_cut",
      "text": "Hold still. I\u00e2\u20ac\u2122ll cut you free. You can ride with us.",
      "characters": 54,
      "state": "saved",
      "requestId": "l0INKDaejbjnpR5IGem4",
      "chargedCharacters": "24"
    },
    {
      "id": "q6_faelen_leave",
      "text": "Spiders have to eat too.",
      "characters": 24,
      "state": "saved",
      "requestId": "ApzAwq6BX1Vn9fyP3Kj9",
      "chargedCharacters": "11"
    },
    {
      "id": "q6_nettle_ask",
      "text": "What has been done to this wood?",
      "characters": 32,
      "state": "saved",
      "requestId": "rlbyh9adVkHSE23KqOyt",
      "chargedCharacters": "14"
    },
    {
      "id": "q6_nettle_talk",
      "text": "We are here for the men who poison your river with their mine. Your enemy is ours.",
