    {
      "id": "q5_rescue_letters_first",
      "text": "Secure the chest first. Then break his chains.",
      "characters": 46,
      "state": "saved",
      "requestId": "bMKaan3tRST5iIuoqmPL",
      "chargedCharacters": "20"
    },
    {
      "id": "q6_faelen_wyvern",
      "text": "Who pays a bounty on a wyvern?",
