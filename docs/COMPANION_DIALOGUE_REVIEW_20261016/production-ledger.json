      "chargedCharacters": "30"
    },
    {
      "id": "dorran__q9_exp_gap_dorran_1",
      "voiceId": "7ma36jg9JC0d1pfrWXMw",
      "text": "[steady] I will keep the door clear. You find the papers.",
