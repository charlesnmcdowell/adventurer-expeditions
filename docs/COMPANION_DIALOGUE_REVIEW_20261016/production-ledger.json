      "chargedCharacters": "25"
    },
    {
      "id": "dorran__q11_exp_gap_dorran_1",
      "voiceId": "7ma36jg9JC0d1pfrWXMw",
      "text": "[firm] L-let them look. They will have to get past my shield.",
